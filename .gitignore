# Data files (large datasets)
*.csv
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle

# But keep example/small data files if needed
!example_data.csv

# Model files - INCLUDE trained models (they're small, <2MB total)
# This allows users to use pre-trained models without retraining
!output/models/**/*.json
!output/models/**/*.pkl
!output/models/**/*.joblib

# Exclude large model formats if they exist
*.bin
*.h5
*.hdf5
*.onnx

# Output directories (generated files)
logs/
checkpoints/

# But keep the directory structure
!output/.gitkeep
!output/models/.gitkeep
!output/models/xgboost/.gitkeep
!output/models/lightgbm/.gitkeep
!output/models/catboost/.gitkeep
!output/models/ensemble/.gitkeep

# Plots and visualizations
*.png
*.jpg
*.jpeg
*.pdf
*.svg

# But keep documentation images
!docs/**/*.png
!docs/**/*.jpg

